# Never commit backend/.env.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
DATABASE_URL=postgresql+psycopg://sme:replace-password@127.0.0.1:5432/study_materials
TEST_DATABASE_URL=postgresql+psycopg://sme:replace-password@127.0.0.1:5432/study_materials_test
AUTH_SECRET=replace-with-at-least-32-random-characters
TOKEN_MINUTES=60
# Cloud deployment only: keep the service role key on the server, never in Vite.
STORAGE_BACKEND=local
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-server-secret
# SUPABASE_BUCKET=materials
# UPLOADS_DIR=C:/study-materials/uploads
# Study assistant / AI Agent (optional). Get a key at https://console.anthropic.com. Leave empty to turn off.
ANTHROPIC_API_KEY=
# CHATBOT_MODEL=claude-sonnet-5-5
# CHATBOT_MAX_TOKENS=800
# CHATBOT_TEMPERATURE=0.3
# CHATBOT_TOOLS_ENABLED=true
# CHATBOT_MAX_TOOL_STEPS=4
# CHATBOT_SYSTEM_PROMPT=
# Keep backups on a different disk or machine from uploads when possible.
# BACKUPS_DIR=D:/study-materials-backups
# BACKUP_KEEP=7
# BACKUP_SCHEDULE_ENABLED=false
# BACKUP_INTERVAL_HOURS=24
# BACKUP_SCHEDULE_HOUR_UTC=2
